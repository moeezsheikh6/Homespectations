{%- comment -%}
  Centred-logo header: search icon left, logo centre, account + cart right.
  Desktop only; the mobile header (header-mobile) is unchanged.
  The menu row underneath is the existing header-navigation-compact section.
{%- endcomment -%}
{%- style -%}
  @media (max-width: 1024px) { .section-header-centered { display: none; } }
  .header-centered { background: {{ section.settings.background }}; position: relative; z-index: 4; }
  .header-centered__inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; {% if section.settings.divider_color != blank and section.settings.divider_color != 'rgba(0,0,0,0)' %}border-bottom: 1px solid {{ section.settings.divider_color }};{% endif %} }
  .header-centered__left { justify-self: start; }
  .header-centered__logo { justify-self: center; text-align: center; margin: 0; line-height: 0; }
  .header-centered__logo img { width: {{ section.settings.logo_width }}px; max-width: 100%; height: auto; }
  .header-centered__logo .h2 { line-height: 1.2; color: {{ section.settings.icon_color }}; }
  .header-centered__right { justify-self: end; display: flex; align-items: center; gap: 28px; }
  .header-centered__icon { display: inline-flex; align-items: center; justify-content: center; position: relative; color: {{ section.settings.icon_color }}; background: none; border: 0; padding: 4px; cursor: pointer; }
  .header-centered__icon svg { width: 22px; height: 22px; fill: currentColor; }
  .header-centered .cart-count-bubble { position: absolute; top: -4px; right: -8px; min-width: 18px; height: 18px; border-radius: 9px; background: {{ section.settings.bubble_bg }}; color: {{ section.settings.bubble_color }}; font-size: 11px; line-height: 18px; text-align: center; padding: 0 4px; }
  .header-centered .cart-count-bubble .text { color: {{ section.settings.bubble_color }}; }
  .header-centered__search > summary { list-style: none; }
  .header-centered__search > summary::-webkit-details-marker { display: none; }
  .header-centered__search .hc-close { display: none; }
  .header-centered__search[open] .hc-open { display: none; }
  .header-centered__search[open] .hc-close { display: inline-flex; }
  .header-centered__search-panel { position: absolute; left: 0; right: 0; top: 100%; background: {{ section.settings.background }}; box-shadow: 0 8px 16px rgba(0,0,0,.08); padding: 24px 15px; }
  .header-centered__search-panel form { max-width: 640px; margin: 0 auto; display: flex; border-bottom: 1px solid {{ section.settings.icon_color }}; }
  .header-centered__search-panel input[type="search"] { flex: 1; border: 0; background: none; font-size: 20px; padding: 10px 0; outline: none; color: {{ section.settings.icon_color }}; }
  .header-centered__search-panel button { background: none; border: 0; cursor: pointer; color: {{ section.settings.icon_color }}; }
  .header-centered__search-panel button svg { width: 22px; height: 22px; fill: currentColor; }
{%- endstyle -%}

<header class="header-centered">
  <div class="container container-{{ section.settings.container }}">
    <div class="header-centered__inner">
      <div class="header-centered__left">
        {%- if section.settings.show_search -%}
          <details class="header-centered__search">
            <summary class="header-centered__icon" aria-label="{{ 'general.search.search' | t }}">
              <span class="hc-open">{% render 'icon-search-02' %}</span>
              <span class="hc-close">{% render 'icon-close' %}</span>
            </summary>
            <div class="header-centered__search-panel">
              <form action="{{ routes.search_url }}" method="get" role="search">
                <label class="visually-hidden" for="Search-Header-Centered">{{ 'general.search.search' | t }}</label>
                <input id="Search-Header-Centered" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.search_the_store' | t }}" autocomplete="off">
                <input type="hidden" name="options[prefix]" value="last">
                <input type="hidden" name="type" value="product">
                <button type="submit" aria-label="{{ 'general.search.search' | t }}">{% render 'icon-search-02' %}</button>
              </form>
            </div>
          </details>
        {%- endif -%}
      </div>

      <{% if request.page_type == 'index' %}h1{% else %}div{% endif %} class="header-centered__logo">
        <a href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {%- assign logo = section.settings.logo -%}
            {%- assign logo_height = section.settings.logo_width | divided_by: logo.aspect_ratio | round -%}
            {{ logo | image_url: width: 500 | image_tag:
              widths: '150, 200, 250, 300, 400, 500',
              width: section.settings.logo_width,
              height: logo_height,
              alt: shop.name
            }}
          {%- else -%}
            <span class="h2">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </{% if request.page_type == 'index' %}h1{% else %}div{% endif %}>

      <div class="header-centered__right">
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header-centered__icon"{% unless customer %}{% if routes.account_login_url contains '/account/login' %} data-open-auth-sidebar{% endif %}{% endunless %}>
            {% render 'icon-account-2' %}
            <span class="visually-hidden">{% if customer %}{{ 'customer.account_fallback' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.show_wishlist and settings.show_wishlist -%}
          <a href="{% if settings.link_wishlist != blank %}{{ settings.link_wishlist }}{% else %}{{ pages['wish-list'].url }}{% endif %}" class="header-centered__icon">
            {% render 'icon-heart-2' %}
            <span class="visually-hidden">{{ 'wishlist.general.wishlist' | t }}</span>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="header-centered__icon header__icon--cart cart-icon-bubble"{% if settings.show_quick_cart %} data-cart-sidebar{% endif %}>
          {% render 'icon-cart-03' %}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span class="text" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('click', function (e) {
    var d = document.querySelector('.header-centered__search[open]');
    if (d && !d.contains(e.target)) d.removeAttribute('open');
  });
</script>

{% schema %}
{
  "name": "Header - Centred logo",
  "limit": 1,
  "class": "section-header-centered",
  "settings": [
    { "type": "select", "id": "container", "label": "Container width", "default": "1770",
      "options": [
        { "value": "1170", "label": "1170px" },
        { "value": "1370", "label": "1370px" },
        { "value": "1470", "label": "1470px" },
        { "value": "1570", "label": "1570px" },
        { "value": "1770", "label": "1770px" },
        { "value": "full", "label": "Full width" }
      ] },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 300, "step": 10, "unit": "px", "default": 160 },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist icon", "default": false },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "icon_color", "label": "Icon colour", "default": "#111111" },
    { "type": "color", "id": "divider_color", "label": "Divider line colour", "default": "#e6e6e6" },
    { "type": "color", "id": "bubble_bg", "label": "Cart count background", "default": "#ba7a2d" },
    { "type": "color", "id": "bubble_color", "label": "Cart count text", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 26 }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
